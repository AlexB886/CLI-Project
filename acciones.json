{
  "version": 1,
  "acciones": [
    {
      "nombre": "listar",
      "descripcion": "Lista el contenido de una carpeta en una tabla.",
      "tipo": "funcion",
      "ejecutar": "listar",
      "destructiva": false,
      "parametros": {
        "carpeta": {
          "tipo": "ruta",
          "por_defecto": "."
        }
      }
    },
    {
      "nombre": "validar",
      "descripcion": "Comprueba que una ruta existe, es un fichero y no está vacío.",
      "tipo": "funcion",
      "ejecutar": "validar",
      "destructiva": false,
      "parametros": {
        "ruta": {
          "tipo": "ruta",
          "requerido": true
        }
      }
    },
    {
      "nombre": "borrar",
      "descripcion": "Borra un fichero. Acción destructiva: exige --dry-run o confirmación.",
      "tipo": "funcion",
      "ejecutar": "borrar",
      "destructiva": true,
      "parametros": {
        "ruta": {
          "tipo": "ruta",
          "requerido": true
        },
        "base": {
          "tipo": "ruta",
          "por_defecto": "."
        }
      }
    },
    {
      "nombre": "ver",
      "descripcion": "Muestra el contenido de un fichero de texto por consola.",
      "tipo": "funcion",
      "ejecutar": "ver",
      "destructiva": false,
      "parametros": {
        "ruta": {
          "tipo": "ruta",
          "requerido": true
        }
      }
    },
    {
      "nombre": "tamano",
      "descripcion": "Calcula el tamaño total de una carpeta, recursivo y seguro (nombre del comando: tamano).",
      "tipo": "funcion",
      "ejecutar": "tamano",
      "destructiva": false,
      "parametros": {
        "carpeta": {
          "tipo": "ruta",
          "por_defecto": "."
        }
      }
    },
    {
      "nombre": "resumir-ia",
      "descripcion": "Resume un fichero de texto en unas tres líneas con IA.",
      "tipo": "funcion",
      "ejecutar": "resumir-ia",
      "destructiva": false,
      "ia": true,
      "parametros": {
        "ruta": {
          "tipo": "ruta",
          "requerido": true
        }
      }
    },
    {
      "nombre": "tarea-ia",
      "descripcion": "Convierte texto libre en una tarea estructurada con IA.",
      "tipo": "funcion",
      "ejecutar": "tarea-ia",
      "destructiva": false,
      "ia": true,
      "parametros": {
        "texto": {
          "tipo": "texto",
          "requerido": true,
          "ayuda": "Texto que describe la tarea que quieres crear."
        }
      }
    },
    {
      "nombre": "repaso-ia",
      "descripcion": "Genera un documento de repaso ODT con IA a partir de tus apuntes y lo abre en LibreOffice Writer.",
      "tipo": "funcion",
      "ejecutar": "repaso-ia",
      "destructiva": false,
      "ia": true,
      "parametros": {
        "archivos": {
          "tipo": "rutas",
          "requerido": true,
          "ayuda": "Apuntes de entrada (txt, md, pdf, docx, odt…); se pueden indicar varios."
        },
        "objetivo": {
          "tipo": "texto",
          "por_defecto": "repaso general",
          "ayuda": "Objetivo de estudio: examen tipo test, examen de desarrollo o repaso general."
        },
        "salida": {
          "tipo": "ruta",
          "ayuda": "Carpeta donde guardar el repaso (por defecto, la carpeta del primer apunte)."
        },
        "nombre": {
          "tipo": "texto",
          "ayuda": "Nombre del documento generado (sin extensión)."
        },
        "abrir": {
          "tipo": "booleano",
          "por_defecto": true,
          "ayuda": "Abre el repaso en LibreOffice Writer al terminar."
        },
        "base": {
          "tipo": "ruta",
          "por_defecto": ".",
          "ayuda": "Raíz autorizada para leer los apuntes y guardar el repaso (por defecto, el cwd)."
        },
        "paralelo": {
          "tipo": "entero",
          "por_defecto": 3,
          "ayuda": "Peticiones simultáneas al sintetizar documentos largos (1 a 8)."
        }
      }
    }
  ]
}